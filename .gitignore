# --- 凭据 ---
.env
*.key
*.pem
*.p12

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- 数据（完整行情不进入 Git） ---
data/
!data/.gitkeep
*.duckdb
*.duckdb.wal
*.parquet
# 允许提交的示例数据样本（小型合成）除外
!tests/data/*.parquet
!tests/data/*.csv
!reports/phase-2/*.parquet
!reports/phase-3/*.parquet
!reports/phase-3/golden-input/*.parquet

# --- 日志与生成产物 ---
logs/
# state/：运行状态、锁文件、真实 Gate 4B 观察进度——一律不得进入 Git
state/
# coverage.json 由测试生成，保留为报告输入
reports/phase-1/coverage.json
# 临时 CLI 双跑目录（验证用，不得忽略正式 reports/phase-2/）
reports/phase-2-run1/
reports/phase-2-run2/
reports/phase-3-run1/
reports/phase-3-run2/

# --- 系统 ---
.DS_Store
Thumbs.db

# --- Phase 4 示例审计产物（小型合成，允许提交） ---
!reports/phase-4/**/*.parquet
!research_data/*.parquet
